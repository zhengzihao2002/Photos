{
  "name": "photos",
  "productName": "Photos",
  "version": "1.0.0",
  "description": "A local, offline Photos-style library for macOS. Read-only: it never changes your photo folders. Not affiliated with Apple.",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "echo \"Use ./dev start instead of npm start.\" && exit 1",
    "dist": "echo \"Use ./dev dist instead of npm run dist.\" && exit 1",
    "preinstall": "[ \"$PHOTOS_DEV\" = \"1\" ] || { echo \"Use ./dev setup instead of npm install.\"; exit 1; }",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.zhengzihao2002.photos-clone",
    "productName": "Photos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/x64/**",
      "!node_modules/ffprobe-static/bin/{linux,win32}/**",
      "!node_modules/ffprobe-static/bin/darwin/x64/**",
      "!**/*.md",
      "!**/*.map",
      "!**/test/**",
      "!**/docs/**"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSHasLocalizedDisplayName": true,
        "CFBundleDisplayName": "Photos",
        "CFBundleLocalizations": [
          "en",
          "zh-Hans"
        ],
        "CFBundleDevelopmentRegion": "en",
        "LSMinimumSystemVersion": "12.0",
        "NSHighResolutionCapable": true,
        "NSHumanReadableCopyright": "Copyright © 2026 The Photos contributors. MIT License. Not affiliated with Apple."
      },
      "extraResources": [
        {
          "from": "build/en.lproj",
          "to": "en.lproj"
        },
        {
          "from": "build/zh-Hans.lproj",
          "to": "zh-Hans.lproj"
        },
        {
          "from": "resources/geo",
          "to": "geo"
        },
        {
          "from": "resources/models",
          "to": "models"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "THIRD_PARTY_NOTICES.md",
          "to": "THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "asar": false,
    "npmRebuild": false,
    "copyright": "Copyright © 2026 The Photos contributors. MIT License.",
    "afterPack": "build/after-pack.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "exifr": "7.1.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "onnxruntime-node": "1.30.0",
    "sharp": "0.35.5"
  },
  "license": "MIT",
  "author": "The Photos contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhengzihao2002/Photos.git"
  },
  "homepage": "https://github.com/zhengzihao2002/Photos"
}
